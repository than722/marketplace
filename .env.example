NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only. Supabase > Project Settings > API > service_role. Never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Stripe sandbox keys supplied with the test. Keep them in .env.local / Vercel only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Printed once by scripts/create-webhook.mjs
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: your production URL, used for Stripe redirect links (falls back to the request URL)
NEXT_PUBLIC_SITE_URL=

# Optional: email the seller when a message arrives (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Marketplace <onboarding@resend.dev>
